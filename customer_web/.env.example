# ==============================================================================
# AAJORI CUISINE CUSTOMER WEB - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# API Base URL pointing to admin_panel API
# In production: https://cuisine-admin.aajori.in/api/v1
# In local development: http://localhost:3000/api/v1
VITE_API_BASE_URL=https://cuisine-admin.aajori.in/api/v1

# ==============================================================================
# FIREBASE CLOUD MESSAGING (FCM) CONFIGURATION
# ==============================================================================
# 1. From Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# 2. From Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=BL1...
